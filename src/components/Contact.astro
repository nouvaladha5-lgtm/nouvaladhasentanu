---
// Contact.astro (Nouval Adha Sentanu — Kontak & Komunikasi Ramah)

const emailAddress = "nouvaladha5@gmail.com";
const githubUrl = "https://github.com/nouvaladha5-lgtm";
const whatsappUrl = "https://wa.me/08816787451";
---

<section id="kontak" class="py-20 sm:py-28 relative">
  
  <!-- Architectural Corner Crosshairs (+) -->
  <span class="crosshair-corner top-0 left-4 sm:left-8 -translate-y-1/2">+</span>
  <span class="crosshair-corner top-0 right-4 sm:right-8 -translate-y-1/2">+</span>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    
    <!-- Section Identifier Header -->
    <div class="mb-12 fade-up-element">
      <div class="inline-flex items-center gap-2 mono-label text-[#0052FF] font-semibold mb-2 bg-blue-50/80 px-2.5 py-1 rounded-lg border border-blue-200 text-xs">
        <span class="w-1.5 h-1.5 rounded-full bg-[#0052FF]"></span>
        <span>Hubungi Saya</span>
      </div>
      <h2 class="section-heading text-3xl sm:text-4xl font-semibold text-[#0A192F]">
        Hubungi Saya
      </h2>
      <p class="body-editorial body-constrained mt-2 text-sm sm:text-base text-[#475569]">
        Ada pertanyaan atau butuh bantuan? Silakan hubungi saya untuk informasi lebih lanjut
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      
      <!-- Left Column: Channel Ledger (5 cols) -->
      <div class="lg:col-span-5 flex flex-col justify-between space-y-6 fade-up-element">
        
        <div class="space-y-4">
          <!-- 1. Card Box Email with Dimensional Soft Shadow & Glow -->
          <div class="interactive-card p-4 sm:p-5 rounded-2xl flex items-center gap-4 group">
            <div class="w-11 h-11 min-w-[44px] min-h-[44px] rounded-xl bg-blue-50 border border-blue-200 flex items-center justify-center text-[#0052FF] group-hover:bg-[#0052FF] group-hover:text-white transition-colors">
              <svg class="w-5 h-5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2" />
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
              </svg>
            </div>
            <div class="min-w-0 flex-1">
              <a href={`mailto:${emailAddress}`} class="font-heading font-bold text-sm sm:text-base text-[#0A192F] hover:text-[#0052FF] transition-colors break-all block">
                {emailAddress}
              </a>
              <p class="text-xs text-[#64748B] font-medium mt-0.5">Email utama</p>
            </div>
          </div>

          <!-- 2. Card Box Lokasi with Dimensional Soft Shadow & Glow -->
          <div class="interactive-card p-4 sm:p-5 rounded-2xl flex items-center gap-4 group">
            <div class="w-11 h-11 min-w-[44px] min-h-[44px] rounded-xl bg-blue-50 border border-blue-200 flex items-center justify-center text-[#0052FF] group-hover:bg-[#0052FF] group-hover:text-white transition-colors">
              <svg class="w-5 h-5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
            </div>
            <div class="min-w-0 flex-1">
              <div class="font-heading font-bold text-sm sm:text-base text-[#0A192F]">
                Semarang, Jawa Tengah
              </div>
              <p class="text-xs text-[#64748B] font-medium mt-0.5">Indonesia</p>
            </div>
          </div>

          <!-- 3. Card Box WhatsApp with Dimensional Soft Shadow & Green Glow -->
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="p-4 sm:p-5 bg-white/95 backdrop-blur-md border border-[#E2E8F0] hover:border-[#25D366]/70 rounded-2xl shadow-[0_4px_20px_-2px_rgba(10,25,47,0.05),0_2px_6px_-1px_rgba(10,25,47,0.03)] hover:shadow-[0_16px_36px_-6px_rgba(37,211,102,0.18),0_0_24px_rgba(37,211,102,0.1)] hover:-translate-y-1 transition-all duration-300 flex items-center gap-4 group cursor-pointer block"
          >
            <div class="w-11 h-11 min-w-[44px] min-h-[44px] rounded-xl bg-emerald-50 border border-emerald-200 flex items-center justify-center text-[#25D366] group-hover:bg-[#25D366] group-hover:text-white transition-colors">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.698.074-2.128-.517-1.472-.609-2.456-2.095-2.531-2.193-.075-.099-.597-.796-.597-1.517 0-.722.378-1.077.513-1.222.135-.145.297-.181.396-.181.099 0 .198.002.284.006.091.004.212-.034.331.252.124.298.423 1.03.46 1.105.037.075.061.162.012.26-.049.098-.074.159-.148.245-.074.086-.156.192-.223.258-.075.074-.153.155-.066.304.087.149.387.638.83 1.032.571.507 1.053.664 1.202.738.149.074.236.062.324-.037.087-.099.373-.435.473-.585.099-.15.198-.124.335-.074.136.05.867.409 1.016.483.149.074.248.112.285.174.037.062.037.36-.107.765z"/>
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 1.892.527 3.661 1.442 5.176L2 22l4.981-1.408A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18.182a8.134 8.134 0 01-4.227-1.183l-.303-.18-3.076.87.828-3.023-.198-.316A8.156 8.156 0 013.818 12c0-4.512 3.67-8.182 8.182-8.182 4.512 0 8.182 3.67 8.182 8.182 0 4.512-3.67 8.182-8.182 8.182z"/>
              </svg>
            </div>
            <div class="min-w-0 flex-1">
              <div class="font-heading font-bold text-sm sm:text-base text-[#0A192F] group-hover:text-[#25D366] transition-colors">
                0881-6787-451
              </div>
              <p class="text-xs text-[#64748B] font-medium mt-0.5">WhatsApp aktif</p>
            </div>
          </a>
        </div>

        <!-- 4. Tombol Shortcut WhatsApp (Diposisikan Lebih ke Bawah & Proporsional Sesuai Aspek Rasio) -->
        <div class="pt-6 sm:pt-8">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            style="background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);"
            class="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 min-h-[46px] text-xs font-bold text-white hover:opacity-95 rounded-xl transition-all shadow-sm hover:shadow-md hover:scale-[1.02] active:scale-95"
          >
            <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.698.074-2.128-.517-1.472-.609-2.456-2.095-2.531-2.193-.075-.099-.597-.796-.597-1.517 0-.722.378-1.077.513-1.222.135-.145.297-.181.396-.181.099 0 .198.002.284.006.091.004.212-.034.331.252.124.298.423 1.03.46 1.105.037.075.061.162.012.26-.049.098-.074.159-.148.245-.074.086-.156.192-.223.258-.075.074-.153.155-.066.304.087.149.387.638.83 1.032.571.507 1.053.664 1.202.738.149.074.236.062.324-.037.087-.099.373-.435.473-.585.099-.15.198-.124.335-.074.136.05.867.409 1.016.483.149.074.248.112.285.174.037.062.037.36-.107.765z"/>
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 1.892.527 3.661 1.442 5.176L2 22l4.981-1.408A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18.182a8.134 8.134 0 01-4.227-1.183l-.303-.18-3.076.87.828-3.023-.198-.316A8.156 8.156 0 013.818 12c0-4.512 3.67-8.182 8.182-8.182 4.512 0 8.182 3.67 8.182 8.182 0 4.512-3.67 8.182-8.182 8.182z"/>
            </svg>
            <span>Chat via WhatsApp</span>
            <span>↗</span>
          </a>
        </div>

      </div>

      <!-- Right Column: Interactive Inquiry Form (7 cols) with Soft Shadow & Glow -->
      <div class="lg:col-span-7 interactive-card rounded-2xl p-6 sm:p-8 fade-up-element">
        
        <div class="flex items-center justify-between pb-4 mb-6 border-b border-[#E2E8F0]">
          <h3 class="font-heading font-bold text-base text-[#0A192F]">Kirim Pesan atau Pertanyaan</h3>
          <span class="mono-label text-xs text-[#0052FF] font-semibold bg-blue-50 px-2.5 py-0.5 rounded-lg border border-blue-200">
            Formulir Kontak
          </span>
        </div>

        <form id="contact-form" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="name" class="block text-xs font-semibold text-[#0A192F] mb-1.5">
                Nama Lengkap
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Masukkan nama Anda"
                class="w-full px-3.5 py-2.5 rounded-xl bg-white border border-[#CBD5E1] text-[#0A192F] placeholder-[#94A3B8] focus:outline-none focus:ring-2 focus:ring-[#0052FF]/20 focus:border-[#0052FF] body-editorial text-sm transition-all"
              />
            </div>

            <div>
              <label for="email" class="block text-xs font-semibold text-[#0A192F] mb-1.5">
                Alamat Email
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="nama@email.com"
                class="w-full px-3.5 py-2.5 rounded-xl bg-white border border-[#CBD5E1] text-[#0A192F] placeholder-[#94A3B8] focus:outline-none focus:ring-2 focus:ring-[#0052FF]/20 focus:border-[#0052FF] body-editorial text-sm transition-all"
              />
            </div>
          </div>

          <div>
            <label for="subject" class="block text-xs font-semibold text-[#0A192F] mb-1.5">
              Subjek Pesan
            </label>
            <input
              type="text"
              id="subject"
              name="subject"
              required
              placeholder="Contoh: Diskusi Pembuatan Website / Pertanyaan Desain"
              class="w-full px-3.5 py-2.5 rounded-xl bg-white border border-[#CBD5E1] text-[#0A192F] placeholder-[#94A3B8] focus:outline-none focus:ring-2 focus:ring-[#0052FF]/20 focus:border-[#0052FF] body-editorial text-sm transition-all"
            />
          </div>

          <div>
            <label for="message" class="block text-xs font-semibold text-[#0A192F] mb-1.5">
              Pesan Anda
            </label>
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              placeholder="Tuliskan pesan, pertanyaan, atau detail diskusi Anda di sini..."
              class="w-full px-3.5 py-2.5 rounded-xl bg-white border border-[#CBD5E1] text-[#0A192F] placeholder-[#94A3B8] focus:outline-none focus:ring-2 focus:ring-[#0052FF]/20 focus:border-[#0052FF] body-editorial text-sm resize-none transition-all"
            ></textarea>
          </div>

          <div class="pt-2 flex flex-col sm:flex-row items-center justify-between gap-4">
            <button
              type="submit"
              id="submit-btn"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 min-h-[44px] mono-label text-xs font-bold text-white bg-[#0052FF] hover:bg-[#0040CC] rounded-xl shadow-sm transition-all hover:shadow-md focus:outline-none"
            >
              <span>Kirim Pesan Sekarang</span>
            </button>
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-[#25D366] hover:underline font-semibold flex items-center gap-1.5 min-h-[44px] py-2"
            >
              <span>Atau chat via WhatsApp</span>
              <span>↗</span>
            </a>
          </div>

          <div id="form-feedback" class="hidden p-3 rounded-xl text-xs mono-label font-medium"></div>
        </form>

      </div>

    </div>

  </div>
</section>

<script>
  function setupContact() {
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const feedback = document.getElementById('form-feedback');

    // Form submission simulation
    if (form && feedback) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const nameInput = (document.getElementById('name') as HTMLInputElement)?.value;
        const subjectInput = (document.getElementById('subject') as HTMLInputElement)?.value;
        const messageInput = (document.getElementById('message') as HTMLTextAreaElement)?.value;

        // Open mailto link with prefilled values
        const mailtoUrl = `mailto:nouvaladha5@gmail.com?subject=${encodeURIComponent(subjectInput)}&body=${encodeURIComponent(`Halo Nouval,\n\nNama: ${nameInput}\n\n${messageInput}`)}`;
        window.location.href = mailtoUrl;

        feedback.className = 'p-3 rounded-xl text-xs mono-label font-medium bg-blue-50 text-[#0052FF] border border-blue-200 block';
        feedback.textContent = 'Terima kasih! Aplikasi email Anda sedang dibuka untuk mengirimkan pesan ini.';
        
        setTimeout(() => {
          form.reset();
        }, 3000);
      });
    }
  }

  setupContact();
  document.addEventListener('astro:after-swap', setupContact);
</script>

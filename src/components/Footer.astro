---
// Footer.astro (Nouval Adha Sentanu — Minimalis, Responsif & Touch-Friendly)
const whatsappUrl = "https://wa.me/08816787451";
const githubUrl = "https://github.com/nouvaladha5-lgtm";
const instagramUrl = "https://www.instagram.com/adasntanuu11";
---

<footer class="py-8 border-t border-[#E2E8F0] bg-white/95 backdrop-blur-md relative z-10">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
      
      <!-- Pojok Kiri Bawah: Copyright Persis Sesuai Permintaan -->
      <p class="text-sm text-[#475569] font-normal tracking-normal">
        © 2026 Nouval Adha Sentanu
      </p>

      <!-- Pojok Kanan Bawah: 3 Ikon Logo (GitHub, Instagram, WhatsApp) HANYA SVG (Touch target 44px x 44px) -->
      <div class="flex items-center gap-3">
        <!-- GitHub Icon -->
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub Nouval Adha Sentanu"
          class="w-11 h-11 min-w-[44px] min-h-[44px] rounded-xl bg-white border border-[#E2E8F0] hover:border-[#0052FF] text-[#0A192F] hover:text-[#0052FF] hover:bg-blue-50/50 flex items-center justify-center transition-all duration-200 shadow-xs focus:outline-none"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">

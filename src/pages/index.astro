---
// src/pages/index.astro (Nouval Adha Sentanu — Portofolio Web Dev & Desainer PPLG)
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Projects from '../components/Projects.astro';
import Specifications from '../components/Specifications.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="id" class="scroll-smooth overflow-x-hidden">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Frontend Security Meta Tags -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'none';"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />

    <!-- SEO Meta Tags -->
    <title>Nouval Adha Sentanu — Desainer Website & UI/UX (PPLG)</title>
    <meta
      name="description"
      content="Portofolio resmi Nouval Adha Sentanu — Siswa Jurusan Pengembangan Perangkat Lunak dan Gim (PPLG) SMKN 9 Semarang. Menampilkan proyek web development, pemodelan 3D Blender, dan karya desain grafis & UI/UX."
    />
    <meta name="author" content="Nouval Adha Sentanu" />
    <meta name="keywords" content="Nouval Adha Sentanu, PPLG, Desainer Website, UI/UX, Blender 3D, Web Development, SMKN 9 Semarang" />

    <!-- Google Fonts: Inter & Outfit (Identik dengan Referensi ghaniyfadhilaltaf.my.id) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="min-h-screen bg-[#F8FAFC] text-[#0A192F] font-sans antialiased selection:bg-[#0052FF] selection:text-white relative overflow-x-hidden">
    
    <!-- FIXED AMBIENT BACKGROUND LAYER (Atmospheric Depth & Technical Mesh) -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
      
      <!-- Ice-Blue & Soft Azure Atmospheric Gradients (Blur 80-100px) -->
      <div class="absolute -top-24 -left-32 w-[650px] h-[500px] bg-[#E0F2FE] opacity-60 rounded-full blur-[90px]"></div>
      <div class="absolute top-48 -right-32 w-[550px] h-[450px] bg-[#DBEAFE] opacity-50 rounded-full blur-[80px]"></div>
      <div class="absolute top-1/2 left-1/4 -translate-x-1/2 w-[750px] h-[600px] bg-[#E0F2FE] opacity-45 rounded-full blur-[100px]"></div>
      <div class="absolute bottom-10 right-10 w-[600px] h-[500px] bg-[#DBEAFE] opacity-40 rounded-full blur-[90px]"></div>

      <!-- Masked Technical Dot Matrix Layer (24px x 24px, masked toward edges) -->
      <div class="absolute inset-0 masked-dot-grid opacity-75"></div>

      <!-- Giant Faint Typography Watermark in Outfit (Opacity: 0.03, #0052FF) -->
      <div class="absolute top-28 left-4 sm:left-12 font-black text-[#0052FF] opacity-[0.03] text-[13vw] leading-none whitespace-nowrap select-none tracking-tighter" style="font-family: 'Outfit', sans-serif;">
        NOUVAL ADHA
      </div>
      <div class="absolute top-2/3 right-4 sm:right-12 font-black text-[#0052FF] opacity-[0.025] text-[11vw] leading-none whitespace-nowrap select-none tracking-tighter" style="font-family: 'Outfit', sans-serif;">
        DESAIN & WEB
      </div>

    </div>

    <!-- Architectural Top Navigation Bar -->
    <Navbar />

    <!-- Main Content Flow (Z-10 elevated above ambient layer, overflow-x hidden) -->
    <main class="relative z-10 overflow-x-hidden">
      <Hero />
      <About />
      <Projects />
      <Specifications />
      <Contact />
    </main>

    <!-- Minimalist Footer -->
    <Footer />

    <!-- Global Scroll Reveal (Fade-Up Animation) Script -->
    <script>
      function initScrollFadeUp() {
        const elements = document.querySelectorAll('.fade-up-element');
        if (!elements.length) return;

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
              }
            });
          },
          {
            threshold: 0.12,
            rootMargin: '0px 0px -40px 0px'
          }
        );

        elements.forEach((el) => observer.observe(el));
      }

      initScrollFadeUp();
      document.addEventListener('astro:after-swap', initScrollFadeUp);
    </script>
  </body>
</html>
